[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_3="interactables"

[physics]

3d/default_gravity=12.0

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[shader_globals]

wg_player_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
